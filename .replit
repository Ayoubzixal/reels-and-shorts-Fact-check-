run = "cd backend && npm install && npm run build && npm start"
entrypoint = "backend/src/index.ts"

[nix]
channel = "stable-24_05"

[deployment]
# Deployment assumes build already ran - just start the server fast
run = ["sh", "-c", "cd backend && node dist/index.js"]
build = ["sh", "-c", "cd backend && npm install && npm run build"]

[[ports]]
localPort = 3000
externalPort = 80
